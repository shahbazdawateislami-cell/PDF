{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Digital PDF product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "salePrice": { "type": "number" },
        "coverImage": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "title", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "customerId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "paid", "delivered"] },
        "price": { "type": "number" }
      },
      "required": ["id", "productId", "customerId", "status", "price"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Customer payment record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "paymentId": { "type": "string" },
        "status": { "type": "string" },
        "amount": { "type": "number" }
      },
      "required": ["id", "orderId", "paymentId", "status", "amount"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "DownloadLog": {
      "title": "DownloadLog",
      "description": "Download activity log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "orderId", "timestamp"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin user UID",
      "type": "object",
      "properties": {
        "uid": { "type": "string" }
      },
      "required": ["uid"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "Product" },
      "description": "Products collection"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "Order" },
      "description": "Orders collection"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "Payment" },
      "description": "Payments collection"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "Customer" },
      "description": "Customers collection"
    },
    "/download_logs/{logId}": {
      "schema": { "$ref": "DownloadLog" },
      "description": "Download logs collection"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "Admin" },
      "description": "Admins collection"
    }
  }
}
